<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="สถิติเชิงปริมาณเรื่องร้องเรียนการทุจริตประพฤติมิชอบของบุคลากร วิทยาลัยการอาชีพบ่อไร่" />
  <title><%= title %></title>
  <link rel="icon" href="/my-logo.webp" type="image/webp" />
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --complaint-primary: #ef4444;
      --complaint-primary-glow: rgba(239, 68, 68, 0.15);
      --complaint-bg: #f8fafc;
      --complaint-card-bg: #ffffff;
      --complaint-border: #e2e8f0;
      --complaint-text: #0f172a;
      --complaint-muted: #64748b;
    }

    body {
      font-family: 'Sarabun', sans-serif;
      background: var(--complaint-bg);
      color: var(--complaint-text);
      min-height: 100vh;
      scroll-behavior: smooth;
    }

    .hero-banner {
      background: linear-gradient(135deg, #1e1b4b 0%, #1e1515 50%, #0f172a 100%);
      color: #fff;
      padding: 120px 24px 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
      border-bottom: 4px solid var(--complaint-primary);
    }

    .hero-content {
      max-width: 800px;
      margin: 0 auto;
      position: relative;
      z-index: 10;
    }

    .title-h1 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .main-wrap {
      max-width: 950px;
      margin: -30px auto 5rem;
      padding: 0 24px;
      position: relative;
      z-index: 20;
    }

    /* Grid Stats Card */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--complaint-card-bg);
      border: 1px solid var(--complaint-border);
      border-radius: 1.25rem;
      padding: 1.75rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      position: relative;
      overflow: hidden;
      transition: transform 0.2s;
    }

    .stat-card:hover {
      transform: translateY(-2px);
    }

    .stat-card::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 4px;
      background: #e2e8f0;
    }

    .stat-card.primary::before { background: #6366f1; }
    .stat-card.warning::before { background: #f59e0b; }
    .stat-card.success::before { background: #10b981; }
    .stat-card.danger::before { background: #ef4444; }

    .stat-num {
      font-size: 2.2rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }

    .stat-label {
      font-size: 0.9rem;
      font-weight: 700;
      color: #64748b;
      margin-top: 4px;
    }

    /* Layout Cards */
    .dashboard-card {
      background: var(--complaint-card-bg);
      border: 1px solid var(--complaint-border);
      border-radius: 1.5rem;
      padding: 2rem;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
      margin-bottom: 2rem;
    }

    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
      .charts-row {
        grid-template-columns: 1fr;
      }
    }

    .chart-container {
      background: white;
      border: 1px solid var(--complaint-border);
      border-radius: 1.25rem;
      padding: 1.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
      box-sizing: border-box;
    }

    .chart-title {
      font-weight: 800;
      font-size: 1.05rem;
      color: #1e293b;
      margin-bottom: 1.25rem;
      align-self: flex-start;
      border-bottom: 2px solid #f1f5f9;
      width: 100%;
      padding-bottom: 8px;
    }

    .canvas-wrap {
      position: relative;
      width: 100%;
      max-width: 320px;
      height: 250px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Actions Table */
    .action-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      box-sizing: border-box;
    }

    .action-table th {
      background: #f8fafc;
      font-weight: 800;
      font-size: 0.88rem;
      color: #475569;
      text-align: left;
      padding: 12px 16px;
      border-bottom: 2px solid #e2e8f0;
    }

    .action-table td {
      font-size: 0.92rem;
      color: #334155;
      padding: 14px 16px;
      border-bottom: 1px solid #f1f5f9;
    }

    .action-table tr:hover td {
      background: #f8fafc;
    }
  </style>
</head>

<body>
  <%- include('partials/navbar'); %>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="hero-content">
      <h1 class="title-h1">📊 รายงานสถิติเรื่องร้องเรียนทุจริต</h1>
      <p style="color:#cbd5e1; margin:0;">สรุปสถิติเชิงปริมาณการรับเรื่องร้องเรียนและการดำเนินการต่อต้านการทุจริตประพฤติมิชอบของสถานศึกษา</p>
    </div>
  </section>

  <main class="main-wrap">
    
    <!-- STATS GRID -->
    <div class="stats-grid">
      <div class="stat-card primary">
        <div class="stat-num"><%= stats.total %></div>
        <div class="stat-label">เรื่องร้องเรียนทั้งหมด</div>
      </div>
      <div class="stat-card warning">
        <div class="stat-num"><%= stats.pending + stats.investigating %></div>
        <div class="stat-label">อยู่ระหว่างตรวจสอบ</div>
      </div>
      <div class="stat-card success">
        <div class="stat-num"><%= stats.resolved %></div>
        <div class="stat-label">ดำเนินการเสร็จสิ้น (Resolved)</div>
      </div>
      <div class="stat-card danger">
        <div class="stat-num"><%= stats.rejected %></div>
        <div class="stat-label">ไม่เข้าเกณฑ์ตรวจสอบ (Rejected)</div>
      </div>
    </div>

    <!-- CHARTS ROW -->
    <div class="charts-row">
      <!-- Status Chart -->
      <div class="chart-container">
        <div class="chart-title">📊 สัดส่วนตามสถานะการดำเนินงาน</div>
        <div class="canvas-wrap">
          <canvas id="statusChart"></canvas>
        </div>
      </div>

      <!-- Category Chart -->
      <div class="chart-container">
        <div class="chart-title">🍕 สัดส่วนจำแนกตามหมวดหมู่ร้องเรียน</div>
        <div class="canvas-wrap">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </div>

    <!-- ACTION TABLE SUMMARY (O20 / O28 Requirement) -->
    <div class="dashboard-card">
      <h3 style="margin: 0 0 1rem; font-weight: 800; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; color: #0f172a;">
        📢 ตารางสรุปสถิติการจัดการเรื่องร้องเรียนการทุจริต ประจำปีงบประมาณ พ.ศ. 2569
      </h3>
      <p style="font-size: 0.85rem; color: #64748b; margin-top: 0; margin-bottom: 1.5rem;">
        * ข้อมูลในระบบจะถูกคำนวณและอัปเดตแบบเรียลไทม์ (Real-Time) ตามหลักธรรมาภิบาลและการเปิดเผยข้อมูลสาธารณะ
      </p>

      <div style="overflow-x: auto;">
        <table class="action-table">
          <thead>
            <tr>
              <th>ประเภทเรื่องร้องเรียน</th>
              <th style="text-align: center; width: 120px;">ได้รับเรื่อง (เรื่อง)</th>
              <th style="text-align: center; width: 150px;">อยู่ระหว่างการตรวจสอบ</th>
              <th style="text-align: center; width: 140px;">ดำเนินการเสร็จสิ้น</th>
              <th style="text-align: center; width: 140px;">ไม่เข้าเกณฑ์ตรวจสอบ</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>1. การทุจริตประพฤติมิชอบในหน่วยงาน</strong></td>
              <td style="text-align: center; font-weight: bold;"><%= stats.category.fraud %></td>
              <td style="text-align: center; color: #d97706;">
                <%= stats.category.fraud > 0 ? (stats.pending + stats.investigating) : 0 %>
              </td>
              <td style="text-align: center; color: #16a34a; font-weight: bold;">
                <%= stats.category.fraud > 0 ? stats.resolved : 0 %>
              </td>
              <td style="text-align: center; color: #dc2626;">
                <%= stats.category.fraud > 0 ? stats.rejected : 0 %>
              </td>
            </tr>
            <tr>
              <td><strong>2. การให้บริการที่ไม่โปร่งใสหรือไม่เป็นธรรม</strong></td>
              <td style="text-align: center; font-weight: bold;"><%= stats.category.service %></td>
              <td style="text-align: center; color: #d97706;">
                <%= stats.category.service > 0 ? (stats.pending + stats.investigating) : 0 %>
              </td>
              <td style="text-align: center; color: #16a34a; font-weight: bold;">
                <%= stats.category.service > 0 ? stats.resolved : 0 %>
              </td>
              <td style="text-align: center; color: #dc2626;">
                <%= stats.category.service > 0 ? stats.rejected : 0 %>
              </td>
            </tr>
            <tr>
              <td><strong>3. เรื่องร้องเรียน/เสนอแนะทั่วไป</strong></td>
              <td style="text-align: center; font-weight: bold;"><%= stats.category.general %></td>
              <td style="text-align: center; color: #d97706;">
                <%= stats.category.general > 0 ? (stats.pending + stats.investigating) : 0 %>
              </td>
              <td style="text-align: center; color: #16a34a; font-weight: bold;">
                <%= stats.category.general > 0 ? stats.resolved : 0 %>
              </td>
              <td style="text-align: center; color: #dc2626;">
                <%= stats.category.general > 0 ? stats.rejected : 0 %>
              </td>
            </tr>
            <tr style="background: #f8fafc; font-weight: bold; border-top: 2px solid #e2e8f0;">
              <td>รวมผลสะสมทั้งหมด</td>
              <td style="text-align: center; font-size: 1.1rem;"><%= stats.total %></td>
              <td style="text-align: center; color: #d97706;"><%= stats.pending + stats.investigating %></td>
              <td style="text-align: center; color: #16a34a; font-size: 1.1rem;"><%= stats.resolved %></td>
              <td style="text-align: center; color: #dc2626;"><%= stats.rejected %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="display:flex; justify-content:space-between; gap:15px; margin-top:2.5rem; flex-wrap:wrap;">
        <a href="/complaints" class="btn" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; text-decoration:none; padding:10px 20px; border-radius:8px; font-weight:700;">✍️ ยื่นเรื่องร้องเรียน</a>
        <a href="/complaints/track" class="btn" style="background:#0f172a; color:#fff; text-decoration:none; padding:10px 20px; border-radius:8px; font-weight:700;">🔍 ติดตามสถานะเรื่องร้องเรียน</a>
      </div>
    </div>

  </main>

  <%- include('partials/footer'); %>

  <!-- CHARTS RENDERING SCRIPT -->
  <script>
    // Status Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
      type: 'bar',
      data: {
        labels: ['รอรับเรื่อง', 'อยู่ระหว่างตรวจสอบ', 'ดำเนินการเสร็จสิ้น', 'ไม่เข้าเกณฑ์'],
        datasets: [{
          label: 'จำนวนเรื่องร้องเรียน',
          data: [
            <%= stats.pending %>,
            <%= stats.investigating %>,
            <%= stats.resolved %>,
            <%= stats.rejected %>
          ],
          backgroundColor: [
            '#cbd5e1', // pending (gray)
            '#f59e0b', // investigating (orange)
            '#10b981', // resolved (green)
            '#ef4444'  // rejected (red)
          ],
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });

    // Category Chart
    const categoryCtx = document.getElementById('categoryChart').getContext('2d');
    new Chart(categoryCtx, {
      type: 'doughnut',
      data: {
        labels: ['ทุจริตประพฤติมิชอบ', 'บริการไม่โปร่งใส', 'ทั่วไป'],
        datasets: [{
          data: [
            <%= stats.category.fraud %>,
            <%= stats.category.service %>,
            <%= stats.category.general %>
          ],
          backgroundColor: [
            '#ef4444', // fraud (red)
            '#3b82f6', // service (blue)
            '#64748b'  // general (slate)
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 12, font: { family: 'Sarabun' } }
          }
        }
      }
    });
  </script>
</body>

</html>
