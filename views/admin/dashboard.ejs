                <div class="form-group" style="margin: 0;">
                  <label style="font-size: 0.78rem; font-weight: 600; display: block; margin-bottom: 4px;">ชื่อคู่มือ (Label):</label>
                  <input type="text" id="cr-manual-label" class="form-control" placeholder="เช่น คู่มือการร้องเรียนปี 2569" style="height: 38px;" />
                </div>
                <div class="form-group" style="margin: 0;">
                  <label style="font-size: 0.78rem; font-weight: 600; display: block; margin-bottom: 4px;">ไฟล์เอกสาร (PDF):</label>
                  <input type="file" id="cr-manual-file" accept=".pdf,.doc,.docx" class="form-control file-input" style="padding: 5px 8px;" />
                </div>
              </div>
              <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
                <button type="button" id="cr-add-manual-btn" class="btn-accent" style="padding: 6px 16px; font-size: 0.85rem; background: #d97706;">+ เพิ่มคู่มือ</button>
              </div>
            </div>
          </div>

          <!-- === SUMMARY DOCS SECTION === -->
          <div class="form-group form-full">
            <label style="font-weight: 800; font-size: 1rem; display: flex; align-items: center; gap: 8px; margin-bottom: 1rem;">
              📊 รายงานสรุปผลการร้องเรียน
              <span style="font-size: 0.78rem; font-weight: 400; color: var(--color-text-secondary);">สรุปผลการดำเนินการและสถิติรายปี</span>
            </label>

            <!-- Current summary docs list -->
            <div id="complaint-summary-list" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1rem;"></div>

            <!-- Add new summary doc -->
            <div style="background: rgba(139,92,246,0.05); border: 1px dashed rgba(139,92,246,0.3); border-radius: 12px; padding: 1.25rem;">
              <span style="font-size: 0.88rem; font-weight: 700; color: #5b21b6; display: block; margin-bottom: 12px;">📑 เพิ่มรายงานสรุปใหม่ (PDF)</span>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end;">
                <div class="form-group" style="margin: 0;">
                  <label style="font-size: 0.78rem; font-weight: 600; display: block; margin-bottom: 4px;">ชื่อรายงาน (Label):</label>
                  <input type="text" id="cr-summary-label" class="form-control" placeholder="เช่น รายงานสรุปการร้องเรียน ปีงบประมาณ 2569" style="height: 38px;" />
                </div>
                <div class="form-group" style="margin: 0;">
                  <label style="font-size: 0.78rem; font-weight: 600; display: block; margin-bottom: 4px;">ไฟล์รายงาน (PDF):</label>
                  <input type="file" id="cr-summary-file" accept=".pdf,.doc,.docx" class="form-control file-input" style="padding: 5px 8px;" />
                </div>
              </div>
              <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
                <button type="button" id="cr-add-summary-btn" class="btn-accent" style="padding: 6px 16px; font-size: 0.85rem;">+ เพิ่มรายงาน</button>
              </div>
            </div>
          </div>

          <div class="form-actions mt-3">
            <a href="/complaints" target="_blank" class="btn-outline" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">🔗 ดูหน้าร้องเรียน</a>
            <button type="submit" class="btn-accent">💾 บันทึกเอกสารทั้งหมด</button>
          </div>
        </form>
      </div>
    </section>

    <!-- ========================= COMPLAINTS PANEL ========================= -->
    <section id="complaints-panel" class="admin-panel hide">
      <div class="panel-header">
        <div>
          <h1>ระบบจัดการเรื่องร้องเรียนการทุจริต (O19, O20)</h1>
          <p>ตรวจสอบและบริหารจัดการสถานะเรื่องร้องเรียนทุจริตประพฤติมิชอบ</p>
        </div>
      </div>

      <!-- TABS TO SEPARATE ACTIVE AND COMPLETED CASES -->
      <div style="display: flex; gap: 10px; margin-bottom: 1.25rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px;">
        <button type="button" id="complaints-tab-active" onclick="filterComplaintsTab('active')" style="background: #0f172a; color: white; border: none; padding: 8px 18px; border-radius: 8px; font-weight: 800; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;">
          📥 กำลังดำเนินการ (<span id="count-active">0</span>)
        </button>
        <button type="button" id="complaints-tab-closed" onclick="filterComplaintsTab('closed')" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; padding: 8px 18px; border-radius: 8px; font-weight: 800; cursor: pointer; font-size: 0.9rem; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;">
          ✅ เสร็จสิ้น/ปิดเคสแล้ว (<span id="count-closed">0</span>)
        </button>
      </div>

      <div class="admin-card">
        <div class="admin-table-container">
          <table class="admin-table">
            <thead>
              <tr>
                <th style="width: 140px;">รหัส (Token)</th>
                <th style="width: 150px;">หมวดหมู่</th>
                <th>หัวข้อเรื่องร้องเรียน</th>
                <th style="width: 150px;">วันที่ยื่นเรื่อง</th>
                <th style="width: 120px; text-align: center;">สถานะ</th>
                <th style="width: 80px; text-align: center;">จัดการ</th>
              </tr>
            </thead>
            <tbody id="complaints-tbody">
              <tr><td colspan="6" style="text-align:center;">กำลังโหลดรายการข้อร้องเรียน...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Complaint Detail Modal -->
      <div id="complaint-detail-modal" class="modal-overlay">
        <div class="modal-content" style="max-width: 650px;">
          <div class="modal-header">
            <h3>รายละเอียดเรื่องร้องเรียน <span id="complaint-modal-token" style="color: var(--color-accent-primary);">COMP-XXXXXX</span></h3>
            <button type="button" class="modal-close-btn" id="complaint-modal-close-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
          <div class="modal-body">
            <div style="display:flex; flex-direction:column; gap:12px;">
              <div>
                <span style="font-size:0.8rem; font-weight:700; color:#64748b; text-transform:uppercase;">หมวดหมู่</span>
                <div id="complaint-modal-category" style="font-weight:700; color:var(--color-accent-primary);"></div>
              </div>
              <div>
                <span style="font-size:0.8rem; font-weight:700; color:#64748b; text-transform:uppercase;">หัวข้อเรื่อง</span>
                <div id="complaint-modal-title" style="font-weight:700; font-size:1.05rem; color:#1e293b;"></div>
              </div>
              <div>
                <span style="font-size:0.8rem; font-weight:700; color:#64748b; text-transform:uppercase;">รายละเอียดเนื้อความ</span>
                <div id="complaint-modal-detail" style="font-size:0.92rem; line-height:1.5; color:#334155; padding:10px; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0; white-space:pre-line; max-height:150px; overflow-y:auto;"></div>
              </div>
              <div id="complaint-modal-reporter-block" style="background:#f1f5f9; padding:10px; border-radius:8px; border:1px solid #cbd5e1;">
                <span style="font-size:0.8rem; font-weight:800; color:#475569; text-transform:uppercase;">👤 ข้อมูลผู้แจ้งเบาะแส</span>
                <div id="complaint-modal-reporter" style="font-size:0.9rem; color:#334155; margin-top:4px;"></div>
              </div>

              <hr style="border:none; border-top:1px solid #e2e8f0; margin:10px 0;" />

              <form id="complaint-update-form">
                <input type="hidden" id="complaint-modal-id" />
                <div class="form-grid">
                  <div class="form-group form-full">
                    <label for="complaint-modal-status">เปลี่ยนสถานะเรื่องร้องเรียน *</label>
                    <select id="complaint-modal-status" class="form-control" required>
                      <option value="pending">⏳ รอการรับเรื่อง (Pending)</option>
                      <option value="investigating">🔎 อยู่ระหว่างตรวจสอบ (Investigating)</option>
                      <option value="resolved">✅ ดำเนินการเสร็จสิ้น (Resolved)</option>
                      <option value="rejected">❌ ไม่เข้าเกณฑ์ตรวจสอบ (Rejected)</option>
                    </select>
                  </div>
                  <div class="form-group form-full">
                    <label for="complaint-modal-note">บันทึกคำชี้แจงความคืบหน้า (แสดงให้ผู้ร้องเรียนเห็นเมื่อเช็กรหัส Token)</label>
                    <textarea id="complaint-modal-note" class="form-control" rows="4" placeholder="เขียนรายละเอียดคำชี้แจงในการตรวจสอบ/มาตรการแก้ไข..."></textarea>
                  </div>
                </div>
                <div class="form-actions mt-2">
                  <button type="button" id="complaint-modal-cancel-btn" class="btn-outline">ยกเลิก</button>
                  <button type="submit" class="btn-accent">บันทึกสถานะ</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</div>


<script src="/js/admin.js?v=<%= Date.now() %>"></script>
<script src="/js/curriculum-admin.js?v=<%= Date.now() %>"></script>
</body>
</html>
